rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function claims()      { return request.auth.token; }
    function isSignedIn()  { return request.auth != null; }
    function isActive()    { return isSignedIn() && claims().status == 'active'; }
    function isBackoffice(){ return isActive() && claims().role == 'backoffice'; }
    function myCompany()   { return claims().companyId; }

    // Named helper so the messages `read` and `create` rules cannot drift apart.
    function isDossierParticipant(dossierId) {
      return isBackoffice()
        || (isActive()
            && get(/databases/$(database)/documents/dossiers/$(dossierId))
                 .data.companyId == myCompany());
    }

    match /users/{uid} {
      // Owner, back-office, or an active teammate: "Mes collaborateurs" and the
      // company card list read colleagues' profiles, which the owner-only rule
      // used to deny outright.
      allow read: if isSignedIn() && (
        request.auth.uid == uid
        || isBackoffice()
        || (isActive() && myCompany() != null && resource.data.companyId == myCompany())
      );
      // Owner edits profile fields only; role/companyId/status/isAdmin/createdAt
      // are server-set and must never be client-writable.
      allow update: if request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['role', 'companyId', 'status', 'isAdmin', 'createdAt'])
        // A key allow-list alone lets any value through a permitted key (see
        // the dossier update rule below for the same reasoning) — without
        // this, a member could write "MARS" or a number into notificationRegion
        // and silently break their own notification fan-out.
        && (!('notificationRegion' in request.resource.data)
            || request.resource.data.notificationRegion == null
            || request.resource.data.notificationRegion in ['NORTH', 'SOUTH']);
      allow create, delete: if false;

      // Device handles. Owner-only: nothing in the app reads another user's
      // tokens, and the back office has no reason to enumerate devices.
      //
      // Values are pinned for the same reason `notificationRegion` is above: an
      // owner-only rule with no shape check accepts any fields, of any type, in
      // any quantity, and `tokensFor` reads every row of this subcollection on
      // each fan-out. `dispatch` already skips a non-string token, so this is
      // about not letting a signed-in user pack their own subcollection with
      // arbitrary or oversized rows, not about the delivery path.
      match /pushTokens/{deviceId} {
        allow read: if request.auth.uid == uid;
        allow write: if request.auth.uid == uid
          && (request.method == 'delete' || (
               request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
               && request.resource.data.token is string
               && request.resource.data.token.size() > 0
               && request.resource.data.token.size() <= 4096
               && request.resource.data.platform in ['ios', 'android']
               // Typed too, or it is the hole the other two clauses close:
               // an allowed *key* with no type check still accepts a
               // megabyte-long string, and `tokensFor` reads every field of
               // every row on each fan-out.
               && request.resource.data.updatedAt is timestamp
             ));
      }
    }

    match /companies/{companyId} {
      allow read: if isBackoffice()
        || (isSignedIn() && myCompany() == companyId);
      allow write: if false;
    }

    match /dossiers/{dossierId} {
      allow read: if isBackoffice()
        || (isActive() && resource.data.companyId == myCompany());

      // A dealer may only file a dossier for their own company, as themselves,
      // as new work. `region` is client-derived from the submitter's company
      // département and is reassignable by the back-office (page-dossier-management), so only
      // its domain is enforced here — a wrong value is a correctable routing
      // nuisance, not an access boundary.
      allow create: if isActive() && claims().role == 'b2b'
        && request.resource.data.companyId == myCompany()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.status == 'a_traiter'
        && request.resource.data.validatedPrice == null
        && request.resource.data.region in ['NORTH', 'SOUTH'];

      // Exactly the fields DossierManagementForm submits — nothing more —
      // and, unlike the key allow-list alone, each value must stay in the
      // same domain the create rule already enforces. Without this, a
      // hasOnly()-only rule would let a value be swapped for anything
      // (e.g. status: 'banana', region: 'MARS', a negative price) while
      // still passing the key check — a classic create/update inconsistency.
      allow update: if isBackoffice()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'region', 'validatedPrice', 'updatedAt', 'updatedBy'])
        // The notification trigger has no auth context and reads `updatedBy`
        // to skip the person who made the change. Pinning it to the caller is
        // what stops a member silencing their own change for everyone else.
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.status in ['a_traiter', 'en_cours', 'cloture']
        && request.resource.data.region in ['NORTH', 'SOUTH']
        && (request.resource.data.validatedPrice == null
            || (request.resource.data.validatedPrice is number
                && request.resource.data.validatedPrice >= 0));

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isDossierParticipant(dossierId);
        allow create, update, delete: if false;
      }

      // Presence = muted. Only ever your own row, and only on a dossier you
      // can already read — the document's *existence* is the whole payload,
      // so its fields are not validated.
      match /mutes/{uid} {
        allow read, write: if request.auth.uid == uid
          && isDossierParticipant(dossierId);
      }
    }

    match /invitations/{invitationId} {
      allow read, write: if false;
    }
  }
}
