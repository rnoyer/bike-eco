    "@react-native-google-signin/google-signin": "^16.1.2",
    "expo": "~56.0.18",
    "expo-build-properties": "~56.0.24",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.24",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.6",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.11",
    "expo-image-manipulator": "~56.0.23",
    "expo-image-picker": "~56.0.22",
    "expo-linking": "~56.0.16",
    "expo-notifications": "~56.0.23",
    "expo-router": "~56.2.17",
    "expo-splash-screen": "~56.0.14",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "firebase": "^12.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.80.0",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@react-native/jest-preset": "^0.85.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "expo-mcp": "~0.2.1",
    "firebase-admin": "^14.1.0",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.5",
    "react-test-renderer": "19.2.3",
    "test-renderer": "^1.2.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:rules": "firebase emulators:exec --only firestore,storage --project bike-eco-43a84 \"jest --config jest.rules.config.js\"",
    "seed": "FIRESTORE_EMULATOR_HOST=localhost:8080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 tsx scripts/seed.ts"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/src/lib/firestore/__tests__/rules.test.ts",
      "<rootDir>/src/lib/firestore/__tests__/storageRules.test.ts",
      "<rootDir>/functions/lib/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|firebase|@firebase/.*))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^firebase/firestore$": "<rootDir>/__mocks__/firebase/firestore.js",
      "postinstall\\.mjs$": "<rootDir>/__mocks__/firebase/postinstall.js"
    }
  },
  "private": true
}
